{
  "schema_version": 1,
  "id": "pi-code-mode-nim",
  "version": "0.1.0rc11",
  "protocol": "acp",
  "runtime": {
    "kind": "python-uv",
    "python": "3.12",
    "project": ".",
    "lockfile": "uv.lock",
    "entrypoint": [
      "harbor-pi-code-mode",
      "--code-mode",
      "code",
      "--thinking",
      "xhigh",
      "--max-output-tokens",
      "16384",
      "--nim-context-window",
      "1000000"
    ]
  }
}
