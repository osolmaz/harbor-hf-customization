{
  "schema_version": 1,
  "id": "pi-localpi-direct-canary",
  "version": "0.1.0rc9",
  "protocol": "acp",
  "runtime": {
    "kind": "python-uv",
    "python": "3.12",
    "project": ".",
    "lockfile": "uv.lock",
    "entrypoint": [
      "harbor-pi-code-mode",
      "--code-mode",
      "direct",
      "--launcher",
      "localpi",
      "--continue-on-truncation",
      "2",
      "--max-provider-requests",
      "4"
    ]
  }
}
