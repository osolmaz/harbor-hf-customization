{
  "schema_version": 1,
  "id": "pi-localpi-llama-cpp-endpoint-cap-canary",
  "version": "0.1.0rc8",
  "protocol": "acp",
  "runtime": {
    "kind": "python-uv",
    "python": "3.12",
    "project": ".",
    "lockfile": "uv.lock",
    "entrypoint": [
      "harbor-pi-code-mode",
      "--code-mode",
      "direct",
      "--launcher",
      "localpi",
      "--endpoint-engine",
      "llama-cpp",
      "--endpoint-context-window",
      "32768",
      "--thinking",
      "high",
      "--thinking-format",
      "none",
      "--max-output-tokens",
      "16384",
      "--thinking-phase-output-cap",
      "8000",
      "--continue-on-truncation",
      "2"
    ]
  }
}
