{
  "schema_version": 1,
  "id": "pi-localpi-think",
  "version": "0.1.0rc8",
  "protocol": "acp",
  "runtime": {
    "kind": "python-uv",
    "python": "3.12",
    "project": ".",
    "lockfile": "uv.lock",
    "entrypoint": [
      "harbor-pi-code-mode",
      "--code-mode",
      "direct",
      "--launcher",
      "localpi",
      "--continue-on-truncation",
      "2",
      "--max-output-tokens",
      "16384",
      "--thinking",
      "high",
      "--thinking-format",
      "qwen-chat-template"
    ]
  }
}
